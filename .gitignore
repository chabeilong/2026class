# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.turbo/
next-env.d.ts

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.swp
*~

# debug / logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# start-web.sh 的 pid 文件（实际写在 /tmp，这里兜底）
*.pid

# env files —— 真实配置只留在本机，仓库里只提交模板
.env*
!.env.example

# 本地数据库导出、备份
*.sql.gz
*.dump
/local/

# vercel
.vercel

# typescript
*.tsbuildinfo

# editor / IDE
/.idea
/.vscode/*
# 如需共享调试配置，可放开下面两行
# !/.vscode/extensions.json
# !/.vscode/settings.json
