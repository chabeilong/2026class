# 复制为 .env.local 后填写真实值：cp .env.example .env.local
# .env.local 已被 .gitignore 忽略，切勿提交真实密码

# 登录账户（管理员：可查看 / 新增 / 编辑 / 删除；普通用户：仅查看与搜索）
ADMIN_USERNAME=
ADMIN_PASSWORD=
GUEST_USERNAME=
GUEST_PASSWORD=

# 会话 cookie 签名密钥，泄露后所有会话作废（建议 openssl rand -hex 32）
SESSION_SECRET=

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=student
